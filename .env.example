# ============================================================================
# SECURITY NOTICE
# ============================================================================
# OPENROUTER_API_KEY deve ser configurada APENAS via variável de ambiente
# do sistema operacional, NÃO neste arquivo .env!
#
# No Windows (PowerShell ou CMD):
#   setx OPENROUTER_API_KEY "sua-chave-api-aqui"
#
# No Linux/macOS:
#   export OPENROUTER_API_KEY=sua-chave-api-aqui
#
# Este arquivo .env é APENAS para configurações NÃO sensíveis.
# ============================================================================

# OpenRouter API Configuration
# NOTE: OPENROUTER_API_KEY must be set via system environment variable, not here!
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database Configuration
DATABASE_PATH=./data/benchmark.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/benchmark.log

# Test Configuration
DEFAULT_ITERATIONS=1
DEFAULT_MODELS=

# Randomization Seed (optional, controls answer shuffling)
# Three modes:
#   - Empty/None: No randomization (answers stay in original A,B,C,D order)
#   - AUTO: Automatic seed generation (unique per run, based on run_id hash)
#   - Integer: Fixed seed for reproducibility (e.g., 42)
RANDOM_SEED=

# Model Generation Parameters (optional, leave blank for model defaults)
# These control how the model generates responses
# IMPORTANT: For models with reasoning (Qwen, o1, etc.), set MODEL_MAX_TOKENS=16384 or higher
# Without this, llama.cpp defaults to 100 tokens which is insufficient for reasoning models
# LEAVE BLANK to not send these parameters and use model defaults
MODEL_MAX_TOKENS=           # Leave blank to not send
MODEL_TEMPERATURE=          # Leave blank to not send
MODEL_TOP_P=                # Leave blank to not send
MODEL_TOP_K=                # Leave blank to not send
MODEL_REPEAT_PENALTY=       # Leave blank to not send

# Structured Outputs (optional, experimental)
# Uses JSON schema for responses if model supports it
# Falls back to traditional method if not supported
USE_STRUCTURED_OUTPUTS=false

# Vision Support (optional)
# Set to true if your model supports image inputs (multimodal)
# Default: false (text-only)
ENABLE_VISION=false

# Default Prompt (optional)
# Custom instruction for ALL questions (with or without images)
# Leave blank to use default: "Select the correct answer by providing only the letter (A, B, C, or D)."
# Note: The prompt is always the same, regardless of whether the question has an image
DEFAULT_PROMPT=

# Reasoning Tokens (Optional, OpenRouter standard)
# For models that support reasoning (o1, o3, Claude, Gemini, etc.)
# IMPORTANT: Leave all reasoning settings blank to use model defaults
REASONING_EFFORT=           # xhigh, high, medium, low, minimal, none (leave blank to not send)
REASONING_MAX_TOKENS=       # Max tokens for reasoning (leave blank to not send)
REASONING_EXCLUDE=false     # Use reasoning internally but don't return (false = don't exclude)
REASONING_ENABLED=false     # Enable reasoning with defaults (false = use model defaults)
