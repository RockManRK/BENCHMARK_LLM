# OpenRouter API Configuration
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database Configuration
DATABASE_PATH=./data/benchmark.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/benchmark.log

# Test Configuration
DEFAULT_ITERATIONS=1
DEFAULT_MODELS=

# Randomization Seed (optional, for reproducibility)
RANDOM_SEED=

# Model Generation Parameters (optional, leave blank for model defaults)
# These control how the model generates responses
# IMPORTANT: For models with reasoning (Qwen, o1, etc.), set MODEL_MAX_TOKENS=16384 or higher
# Without this, llama.cpp defaults to 100 tokens which is insufficient for reasoning models
MODEL_MAX_TOKENS=
MODEL_TEMPERATURE=
MODEL_TOP_P=
MODEL_TOP_K=
MODEL_REPEAT_PENALTY=

# Structured Outputs (optional, experimental)
# Uses JSON schema for responses if model supports it
# Falls back to traditional method if not supported
USE_STRUCTURED_OUTPUTS=false

# Reasoning Tokens (Optional, OpenRouter standard)
# For models that support reasoning (o1, o3, Claude, Gemini, etc.)
REASONING_EFFORT=           # xhigh, high, medium, low, minimal, none
REASONING_MAX_TOKENS=       # Max tokens for reasoning
REASONING_EXCLUDE=false     # Use reasoning internally but don't return
REASONING_ENABLED=false     # Enable reasoning with defaults
