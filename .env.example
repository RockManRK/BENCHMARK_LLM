# ============================================================================
# SECURITY NOTICE
# ============================================================================
# OPENROUTER_API_KEY deve ser configurada APENAS via variável de ambiente
# do sistema operacional, NÃO neste arquivo .env!
#
# No Windows (PowerShell ou CMD):
#   setx OPENROUTER_API_KEY "sua-chave-api-aqui"
#
# No Linux/macOS:
#   export OPENROUTER_API_KEY=sua-chave-api-aqui
#
# Este arquivo .env é APENAS para configurações NÃO sensíveis.
# ============================================================================

# OpenRouter API Configuration
# NOTE: OPENROUTER_API_KEY must be set via system environment variable, not here!
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Path to the SQLite database file (relative to project root, or absolute).
# Optional: if unset, defaults to ./data/bcllm.db.
# Used by the CLI test suite to redirect execution at an isolated sandbox
# database without copying source code.
DATABASE_PATH=./data/bcllm.db

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO (shows INFO and above on console, DEBUG and above in file)
LOG_LEVEL=INFO

# Log file path (relative to project root)
# Default: ./logs/benchmark.log
LOG_FILE_PATH=./logs/benchmark.log

# Questions Dataset Path (CRITICAL - SOURCE OF TRUTH)
# This is the JSON file containing ALL questions for the benchmark
# Default: data/enamed_questions.json (100 questions)
QUESTIONS_DATASET_PATH=data\enamed_questions.json

# ============================================================================
# EXPERIMENT DEFAULTS (optional)
# These values are stored in experiment.config_json at creation time
# They serve as defaults for downstream entities (models, runs)
# ============================================================================

# Default Questions (optional, used when --add-questions not specified)
# Format: JSON array (e.g., ["Q001","Q002","Q003"])
# If not set, ALL questions from the dataset will be used
DEFAULT_QUESTIONS=

# Questions Status Filter (optional)
# QUESTIONS_STATUS_ADD: Only include questions with these status values
# QUESTIONS_STATUS_EXCLUDE: Exclude questions with these status values
QUESTIONS_STATUS_ADD=
QUESTIONS_STATUS_EXCLUDE=

# ============================================================================
# MODEL DEFAULTS (optional)
# These values are stored in experiment.config_json at creation time
# They serve as defaults when creating model variants
# CLI flags at creation time override these .env defaults
# Leave blank to use model API defaults
# ============================================================================

# Base URL for model API
BASE_URL=https://openrouter.ai/api/v1

# Model Generation Parameters
# IMPORTANT: For reasoning models (Qwen, o1, etc.), set MODEL_MAX_TOKENS_TOTAL=16384 or higher
MODEL_MAX_TOKENS_REASONING=       # Max tokens for reasoning phase
MODEL_MAX_TOKENS_TOTAL=16384      # Max total tokens (reasoning + completion)
MODEL_REASONING_EFFORT=           # xhigh, high, medium, low, minimal, none
MODEL_TEMPERATURE=                # Temperature (0.0-2.0)
MODEL_TOP_P=                      # Top-P sampling (0.0-1.0)
MODEL_TOP_K=                      # Top-K sampling (integer)
MODEL_REPEAT_PENALTY=             # Repeat penalty (1.0-2.0)

# Model Capabilities
MODEL_VISION=false                # Enable vision (multimodal)
STRUCTURED_OUTPUTS=false          # Enable JSON schema responses

# Provider Locking (OpenRouter)
# AUTO_PROVIDER_LOCK=true|false  # Default: false. When true, experiments require resolved providers before execution.
# PROVIDER_SELECTION_STRATEGY=first|cheapest|fastest|lowest-latency  # Default: first. Strategy for --resolve-providers.

# ============================================================================
# RUN DEFAULTS (optional)
# These values are stored in experiment.config_json at creation time
# They serve as defaults when creating runs
# CLI flags at creation time override these .env defaults
# ============================================================================

# Randomization Seed — controls ONLY AnswerRandomizer (the order answer
# options are presented in). Unrelated to Model Seed (sent to the API for
# inference; a model_variant-level setting, not configured here).
# Three modes:
#   - Empty/None: No randomization (answers stay in original A,B,C,D order)
#   - AUTO: Automatic seed generation (unique per run, resolved once at run creation)
#   - Integer: Fixed seed for reproducibility (e.g., 42)
RANDOMIZATION_SEED=AUTO

# Default Prompts (optional)
# SYSTEM_PROMPT: System prompt for all runs (e.g., "You are a helpful assistant.")
# USER_PROMPT: User prompt template with {question} and {options} placeholders
# Leave blank to use no system prompt and default user prompt
SYSTEM_PROMPT=
USER_PROMPT=Select the correct answer by providing only the letter (A, B, C, or D).
